{
  "name": "ppv-foundation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace @gwap/ppv-sdk",
    "test": "npm run typecheck && npm run test:sdk",
    "test:sdk": "npm run test --workspace @gwap/ppv-sdk",
    "test:anchor": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "test:f1": "./scripts/verify-f1.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @gwap/ppv-sdk"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "1.95.8",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "ts-mocha": "10.0.0",
    "typescript": "5.7.3"
  }
}
