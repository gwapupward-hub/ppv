{
  "name": "ppv-foundation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace @gwap/ppv-sdk",
    "test": "npm run typecheck && npm run test:sdk && npm run test:release",
    "test:anchor": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 1000000 \"tests/**/*.ts\"",
    "test:devnet:smoke": "npm run build:sdk --silent && node scripts/devnet-smoke.mjs",
    "test:f1": "./scripts/verify-f1.sh",
    "test:release": "node --test scripts/test/*.test.mjs",
    "test:sdk": "npm run test --workspace @gwap/ppv-sdk",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @gwap/ppv-sdk",
    "verify:devnet-readiness": "./scripts/verify-devnet-readiness.sh"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "1.95.8",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "mocha": "10.8.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
